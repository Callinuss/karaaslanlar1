@model IEnumerable<karaaslanlar1.Models.AfetTalebi>

@{
    ViewData["Title"] = "İhtiyaç Panosu";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-danger fw-bold">Kriz İhtiyaç Panosu</h1>
    <a asp-action="Create" class="btn btn-danger btn-lg shadow-sm">➕ Yeni İhtiyaç Bildir</a>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover border align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Baslik)</th>
                <th>@Html.DisplayNameFor(model => model.Lokasyon)</th>
                <th>Aciliyet</th>
                <th>Tarih</th>
                <th class="text-center">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@Html.DisplayFor(modelItem => item.Baslik)</td>
                    <td>📍 @Html.DisplayFor(modelItem => item.Lokasyon)</td>
                    <td>
                        @* Aciliyet durumuna göre renkli rozetler (Badges) *@
                        @if (item.Derecesi == karaaslanlar1.Models.Aciliyet.Kritik)
                        {
                            <span class="badge bg-danger fs-6">Kritik</span>
                        }
                        else if (item.Derecesi == karaaslanlar1.Models.Aciliyet.Yuksek)
                        {
                            <span class="badge bg-warning text-dark fs-6">Yüksek</span>
                        }
                        else if (item.Derecesi == karaaslanlar1.Models.Aciliyet.Orta)
                        {
                            <span class="badge bg-primary fs-6">Orta</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">Düşük</span>
                        }
                    </td>
                    <td>@item.OlusturulmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">🔍 İncele</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">✏️ Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">🗑️ Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-success text-center mt-3" role="alert">
        Şu an için sisteme girilmiş aktif bir acil durum talebi bulunmamaktadır.
    </div>
}