<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Afet Dayanışma Ağı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* 🚨 SITE.CSS İÇİNDEKİ ARKA PLAN RESMİNE DOKUNMADAN SADECE METİNLERİ VE KARTLARI DÜZELTME */
        body {
            color: #ffffff !important;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Ortadaki o parlayan beyaz alanı ve içindeki p-5 alanını siber mat renge çekiyoruz */
        main .bg-white, main .p-5, .card {
            background-color: rgba(30, 41, 59, 0.95) !important;
            color: #ffffff !important;
            border-radius: 16px !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6) !important;
        }

        /* BÜTÜN AÇIKLAMA VE ALT METİNLERİ JİLET GİBİ OKUNUR YAPMA */
        p, .text-muted, .text-white-50, main font, main span, main p {
            color: #f1f5f9 !important;
            font-weight: 500 !important;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8) !important;
        }

        h1, h2, h3, h4, h5, h6, .card-title, main h1, main h3 {
            color: #ffffff !important;
            font-weight: 700 !important;
            text-shadow: 0 2px 5px rgba(0, 0, 0, 0.9) !important;
        }

        /* NAVBAR TASARIMI */
        .cyber-nav {
            background: rgba(9, 13, 22, 0.95) !important;
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            padding: 1rem 2rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }

        .nav-link {
            color: #ffffff !important;
            font-weight: 600 !important;
            letter-spacing: 0.5px;
        }

            .nav-link:hover {
                color: #ff3344 !important;
            }

        /* 🎯 RAZOR ÇAKIŞMASINI ÖNLEYEN ÇİFT @@ İŞARETLİ LOGO ANIMASYONU */
        @@keyframes logoPulse {
            0% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.7);
            }

            70% {
                transform: scale(1);
                box-shadow: 0 0 0 10px rgba(225, 29, 72, 0);
            }

            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(225, 29, 72, 0);
            }
        }

        .logo-dot {
            width: 10px;
            height: 10px;
            animation: logoPulse 1.5s infinite;
            display: inline-block;
            border-radius: 50%;
            background: #dc3545;
            margin-right: 8px;
        }

        /* YETKİLİ GİRİŞİ BUTONU */
        .btn-admin-cyber {
            background: rgba(255, 255, 255, 0.05);
            color: #ffffff !important;
            border: 1px solid rgba(255, 255, 255, 0.3) !important;
            border-radius: 30px;
            padding: 0.5rem 1.5rem;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            transition: all 0.2s ease;
        }

            .btn-admin-cyber:hover {
                background: #ffffff !important;
                color: #0f172a !important;
                box-shadow: 0 0 15px rgba(255,255,255,0.3);
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md sticky-top cyber-nav">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index" style="font-size: 1.3rem;">
                    <span class="logo-dot"></span>
                    <span style="color: #ffffff !important; font-weight: 800;">AFET</span><span class="text-danger fw-light ms-1">DAYANIŞMA</span>
                </a>

                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0 ms-4 gap-3">
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Index#afetHaritasiKapsayici"><i class="bi bi-geo-alt me-1"></i> CANLI HARİTA</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger fw-extrabold" asp-controller="AfetTalepleri" asp-action="Create" style="color: #ff3344 !important;">
                                <i class="bi bi-exclamation-triangle me-1"></i> İHTIYAÇ BİLDİR
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Gonullu" asp-action="Create"><i class="bi bi-people me-1"></i> GÖNÜLLÜ OL</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (Context.Session.GetString("KullaniciRolu") == "Admin")
                        {
                            <a asp-controller="Home" asp-action="Logout" class="btn btn-danger btn-sm rounded-pill px-4 fw-bold">GÜVENLİ ÇIKIŞ</a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-admin-cyber" data-bs-toggle="modal" data-bs-target="#loginModal">
                                <i class="bi bi-shield-lock me-1"></i> YETKİLİ GİRİŞİ
                            </button>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content border-0 rounded-4 shadow-lg" style="background-color: #0f172a; color: white; border: 1px solid rgba(255,255,255,0.1) !important;">
                <div class="modal-header border-0 p-4 pb-0">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-key me-2"></i>SİSTEM DOĞRULAMA</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <form asp-controller="Home" asp-action="Login" method="post">
                        <div class="mb-3">
                            <label class="small fw-bold text-white-50 mb-1">E-POSTA</label>
                            <input type="email" name="email" class="form-control bg-dark text-white border-secondary py-2" placeholder="admin@afetdayanisma.com" required />
                        </div>
                        <div class="mb-4">
                            <label class="small fw-bold text-white-50 mb-1">ŞİFRE</label>
                            <input type="password" name="sifre" class="form-control bg-dark text-white border-secondary py-2" placeholder="123456" required />
                        </div>
                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold shadow">GİRİŞ YAP</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>