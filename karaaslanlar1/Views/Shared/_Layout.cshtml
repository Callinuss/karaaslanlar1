<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Afet Dayanışma Ağı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark sticky-top px-4 py-3 shadow"
             style="background: #111827 !important; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold d-flex align-items-center fs-4" asp-area="" asp-controller="Home" asp-action="Index" style="letter-spacing: -0.5px; color: #ffffff !important;">
                    <span id="logoDotAnim" class="d-inline-block rounded-circle bg-danger me-2 shadow" style="width: 10px; height: 10px;"></span>
                    <span class="text-white fw-extrabold">Afet</span><span class="text-danger ms-1 fw-light">Dayanışma</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0 ms-md-4 gap-2">
                        <li class="nav-item">
                            <a class="nav-link text-white opacity-hover px-3 rounded-pill fw-semibold d-flex align-items-center gap-2" href="/Home/Index#afetHaritasiKapsayici" style="color: #ffffff !important;">
                                <i class="bi bi-map"></i> Canlı Harita
                            </a>
                        </li>

                        @if (Context.Session.GetString("KullaniciRolu") != "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white bg-danger bg-opacity-25 text-danger border border-danger px-3 rounded-pill fw-bold shadow-sm d-flex align-items-center gap-2"
                                   asp-area="" asp-controller="AfetTalepleri" asp-action="Create" style="border: 1px solid #dc3545 !important; color: #dc3545 !important;">
                                    <i class="bi bi-bell"></i> İhtiyaç Bildir
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white opacity-hover px-3 rounded-pill fw-semibold d-flex align-items-center gap-2"
                                   asp-controller="Gonullu" asp-action="Create" style="color: #ffffff !important;">
                                    <i class="bi bi-person-check"></i> Gönüllü Ol
                                </a>
                            </li>
                        }

                        @if (Context.Session.GetString("KullaniciRolu") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white bg-secondary bg-opacity-50 border border-secondary px-3 rounded-pill fw-bold shadow-sm d-flex align-items-center gap-2"
                                   asp-area="" asp-controller="AfetTalepleri" asp-action="Index" style="color: #ffffff !important;">
                                    <i class="bi bi-file-earmark-text"></i> Gelen Talepler
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white opacity-hover px-3 rounded-pill fw-semibold d-flex align-items-center gap-2"
                                   asp-controller="Gonullu" asp-action="Index" style="color: #ffffff !important;">
                                    <i class="bi bi-people"></i> Başvuruları Yönet
                                </a>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                <span class="badge bg-dark text-danger border border-danger rounded-pill px-3 py-2 ms-2 fw-bold font-monospace" style="font-size:0.75rem; letter-spacing: 0.5px;">SYS_HQ_ROOT</span>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 mt-3 mt-md-0">
                        @if (Context.Session.GetString("KullaniciRolu") == "Admin")
                        {
                            <span class="text-white small me-2 font-monospace" style="color: #ffffff !important;">ROOT_USER</span>
                            <a asp-controller="Home" asp-action="Logout" class="btn btn-outline-danger rounded-pill btn-sm px-3 fw-bold d-flex align-items-center gap-2">
                                <i class="bi bi-door-open"></i> Güvenli Çıkış
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-admin-cyber btn-sm rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#loginModal" style="font-size: 0.85rem; height: 38px;">
                                <i class="bi bi-key-fill"></i> Yetkili Girişi
                            </button>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content border-0 rounded-4 shadow-lg" style="background-color: #131c2e; color: #ffffff;">
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold text-danger" id="loginModalLabel">Yetkili Personel Girişi</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="$('#loginModal').modal('hide')" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form asp-controller="Home" asp-action="Login" method="post">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-white-50">E-Posta Adresi</label>
                            <input type="email" name="email" class="form-control rounded-3 bg-dark text-white border-secondary py-2" placeholder="admin@afet.com" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-white-50">Güvenlik Şifresi</label>
                            <input type="password" name="sifre" class="form-control rounded-3 bg-dark text-white border-secondary py-2" placeholder="••••••" required />
                        </div>
                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-2.5 fw-bold shadow">Sistem Kimliğini Doğrula</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <button id="themeToggleBtn" class="btn btn-dark rounded-circle shadow-lg d-flex align-items-center justify-content-center"
            onclick="karanlikModuKapatAç()"
            style="position: fixed; bottom: 25px; right: 25px; width: 45px; height: 45px; z-index: 9999; border: 1px solid rgba(255,255,255,0.1); transition: all 0.3s ease;">
        <span id="themeIcon" style="font-size: 1.2rem;">🌓</span>
    </button>

    <footer class="footer text-muted bg-white border-top mt-5">
        <div class="container text-center py-4">
            &copy; 2026 - <span class="fw-bold text-dark">Afet Dayanışma Ağı</span> - Karaaslanlar Takımı
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <style>
        html {
            scroll-behavior: smooth;
        }

        @@keyframes logoPulse {
            0% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.7);
            }

            70% {
                transform: scale(1);
                box-shadow: 0 0 0 8px rgba(225, 29, 72, 0);
            }

            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(225, 29, 72, 0);
            }
        }

        #logoDotAnim {
            animation: logoPulse 1.5s infinite;
        }

        .opacity-hover:hover {
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.15) !important;
        }

        /* ASİL MAT SİBER-GRİ BUTON CSS AYARI */
        .btn-admin-cyber {
            background-color: rgba(255, 255, 255, 0.08) !important;
            color: #ffffff !important;
            border: 1px solid rgba(255, 255, 255, 0.3) !important;
            font-size: 0.8rem !important;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            transition: all 0.2s ease-in-out;
        }

            .btn-admin-cyber:hover {
                background-color: rgba(255, 255, 255, 0.2) !important;
                border-color: #0dcaf0 !important;
                color: #0dcaf0 !important;
                box-shadow: 0 0 10px rgba(13, 202, 240, 0.3);
            }

        #themeToggleBtn:hover {
            transform: scale(1.1) rotate(15deg);
        }

        body:not(.dark-mode) #themeToggleBtn {
            background-color: #1e1e1e !important;
        }

        body.dark-mode #themeToggleBtn {
            background-color: #ffc107 !important;
            border-color: #ffca28 !important;
            color: #000000 !important;
        }
    </style>

    <script>
        function karanlikModuKapatAç() {
            var body = document.body;
            body.classList.toggle("dark-mode");
            var icon = document.getElementById("themeIcon");
            if (body.classList.contains("dark-mode")) { icon.innerHTML = "☀️"; } else { icon.innerHTML = "🌓"; }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>