@model karaaslanlar1.Models.AfetTalebi
@{
    ViewData["Title"] = "Yeni İhtiyaç Bildir";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div id="formCard" class="card shadow-lg border-0" style="transition: all 0.4s ease; background-color: #1e293b !important; border: 1px solid rgba(255, 255, 255, 0.15) !important;">
            <div id="cardHeader" class="card-header bg-danger text-white py-3 border-bottom border-light border-opacity-10">
                <h4 class="mb-0 fw-bold text-white"><i class="bi bi-exclamation-triangle-fill me-2"></i>Acil Durum İhtiyaç Bildirim Formu</h4>
            </div>
            <div class="card-body p-4">

                <div id="aiAlert" class="alert alert-danger d-none align-items-center rounded-3 mb-4 border-0 shadow"
                     style="background-color: rgba(220, 53, 69, 0.15) !important; color: #ff4d6d !important; border: 1px solid rgba(220, 53, 69, 0.4) !important;">
                    <span class="fs-4 me-3">🤖</span>
                    <div>
                        <strong style="color: #ffffff !important;">AI Karar Destek System:</strong> <span style="color: #ff4d6d !important;">Metin analizi sonucunda yüksek hayati risk/öncelik tespit edildi. Aciliyet durumu otomatik olarak</span> <strong style="color: #ffffff !important; text-decoration: underline;">Kritik</strong> <span style="color: #ff4d6d !important;">olarak güncellendi.</span>
                    </div>
                </div>

                <form asp-action="Create">
                    <div class="form-group mb-3">
                        <label asp-for="Turu" class="control-label fw-bold mb-1" style="color: #94a3b8 !important;">Afet Türü</label>
                        <select asp-for="Turu" id="Turu" class="form-select rounded-3 text-white fw-bold"
                                asp-items="Html.GetEnumSelectList<karaaslanlar1.Models.AfetTuru>()"
                                style="background-color: #0f172a !important; color: #ffffff !important; border: 1px solid rgba(255,255,255,0.2) !important; height: 46px !important; display: block !important;">
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Baslik" class="control-label fw-bold mb-1" style="color: #94a3b8 !important;">Bildirim Başlığı</label>
                        <input asp-for="Baslik" id="Baslik" class="form-control form-control-lg rounded-3 text-white"
                               placeholder="Örn: Kışlık Çadır ve Isıtıcı İhtiyacı"
                               style="background-color: #0f172a !important; border: 1px solid rgba(255,255,255,0.2) !important;" />
                        <span asp-validation-for="Baslik" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Aciklama" class="control-label fw-bold mb-1" style="color: #94a3b8 !important;">Açıklama (AI Canlı Analiz Desteği Aktif)</label>
                        <textarea asp-for="Aciklama" id="Aciklama" class="form-control rounded-3 text-white" rows="4"
                                  placeholder="İhtiyaç detaylarını ve durumun aciliyetini yazınız..." oninput="aiMetinAnalizi()"
                                  style="background-color: #0f172a !important; border: 1px solid rgba(255,255,255,0.2) !important; color: #ffffff !important;"></textarea>
                        <span asp-validation-for="Aciklama" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Lokasyon" class="control-label fw-bold mb-1" style="color: #94a3b8 !important;">Olay Yeri / Lokasyon</label>
                        <input asp-for="Lokasyon" id="Lokasyon" class="form-control rounded-3 text-white"
                               placeholder="İl, İlçe veya Açık Adres Girişi"
                               style="background-color: #0f172a !important; border: 1px solid rgba(255,255,255,0.2) !important;" />
                        <span asp-validation-for="Lokasyon" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Derecesi" class="control-label fw-bold mb-1" style="color: #94a3b8 !important;">Aciliyet Derecesi</label>
                        <select asp-for="Derecesi" id="Derecesi" class="form-select form-select-lg rounded-3 text-danger fw-bold"
                                style="background-color: #0f172a !important; border: 1px solid rgba(255,255,255,0.2) !important;"
                                asp-items="Html.GetEnumSelectList<karaaslanlar1.Models.Aciliyet>()"></select>
                    </div>

                    <div class="form-group d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg rounded-pill shadow-sm fw-bold py-2.5">Afet Talebini Veritabanına İşle</button>
                        <a asp-action="Index" class="btn btn-outline-light rounded-pill py-2 border-secondary text-white opacity-hover">Panoya Geri Dön</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function aiMetinAnalizi() {
        var metin = document.getElementById("Aciklama").value.toLowerCase();

        var kritikKelimeler = ["enkaz", "ses geliyor", "nefes", "mahsur", "göçük", "kanama", "yaralı", "boğulma", "yangın büyüdü", "acil kurtarma", "bebek var"];
        var riskTespitEdildi = false;

        for (var i = 0; i < kritikKelimeler.length; i++) {
            if (metin.includes(kritikKelimeler[i])) {
                riskTespitEdildi = true;
                break;
            }
        }

        var card = document.getElementById("formCard");
        var alertBox = document.getElementById("aiAlert");
        var dereceSelect = document.getElementById("Derecesi");

        if (riskTespitEdildi) {
            alertBox.classList.remove("d-none");
            card.style.boxShadow = "0 20px 40px rgba(225, 29, 72, 0.3)";
            card.style.borderColor = "#dc3545";
            dereceSelect.value = "0";
        } else {
            alertBox.classList.add("d-none");
            card.style.boxShadow = "0 10px 30px rgba(0, 0, 0, 0.6)";
            card.style.borderColor = "rgba(255, 255, 255, 0.15)";
        }
    }

    window.onload = function() {
        var urlParametreleri = new URLSearchParams(window.location.search);
        var gelenKonum = urlParametreleri.get('gelenKonum');
        var afetTuru = urlParametreleri.get('afetTuru');
        if (gelenKonum != null) {
            document.getElementById('Lokasyon').value = gelenKonum;
            document.getElementById('Derecesi').value = "0";
            if(afetTuru === 'Deprem') {
                document.getElementById('Turu').value = "0";
                document.getElementById('Baslik').value = "⚠️ Deprem Sonrası Acil Lojistik Desteği";
            } else if(afetTuru === 'Yangin') {
                document.getElementById('Turu').value = "1";
                document.getElementById('Baslik').value = "🔥 Yangın Bölgesi Acil Söndürme/Tahliye Talebi";
            } else if(afetTuru === 'Sel') {
                document.getElementById('Turu').value = "2";
                document.getElementById('Baslik').value = "🌊 Sel Bölgesi Acil Tahliye ve Bot Desteği";
            }
            aiMetinAnalizi();
        }
    };
</script>