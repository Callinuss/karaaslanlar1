@{
    ViewData["Title"] = "Ana Sayfa";
    bool isAdmin = ViewContext.View.Path.Contains("AdminDashboard") ||
                   (Context.Request.RouteValues["action"]?.ToString() == "AdminDashboard");
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
    .btn-matrix {
        background-color: #1a1d20 !important;
        color: #f8f9fa !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        font-size: 0.8rem !important;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        transition: all 0.2s ease-in-out;
    }

        .btn-matrix:hover {
            background-color: #212529 !important;
            border-color: #0dcaf0 !important;
            color: #0dcaf0 !important;
            box-shadow: 0 0 10px rgba(13, 202, 240, 0.2);
        }

    .select-matrix {
        background-color: #1a1d20 !important;
        color: #f8f9fa !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        font-size: 0.8rem !important;
        height: 38px;
    }

        .select-matrix:focus {
            border-color: #0dcaf0 !important;
            box-shadow: 0 0 10px rgba(13, 202, 240, 0.2) !important;
        }
</style>

@if (!isAdmin)
{
    <div class="text-center mt-4 mb-4">
        <h1 class="display-4 section-title text-danger fw-bold">Afet Komuta Kontrol Merkezi</h1>
        <p class="lead text-muted max-w-2xl mx-auto mt-2">Yapay zeka triyajı, akıllı lojistik eşleştirme ve siber-fiziksel IoT güvenlik katmanına sahip karar destek sistemi.</p>
    </div>

    <div class="row mt-4 justify-content-center">
        <div class="col-md-8 mb-4">
            <div class="card border-0 p-4 shadow-lg text-center bg-white rounded-4">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h2 class="fw-bold text-danger mb-3">🚨 Acil Yardım İste</h2>
                        <p class="text-muted fs-5">Bölgenizdeki acil lojistik ihtiyaçları (çadır, su, ilaç, tahliye) sisteme girerek saha ekiplerine ve yapay zeka triyaj merkezine anında ulaştırın.</p>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="AfetTalepleri" asp-action="Create" class="btn btn-danger btn-lg rounded-pill px-5 py-3 fw-bold shadow">Yeni İhtiyaç Bildirimi Oluştur</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-4 opacity-25" />
}

<div class="card border-0 bg-dark text-white p-3 mb-4 rounded-4 shadow border border-secondary">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
        <div>
            <h6 id="sensorBaslik" class="mb-1 text-warning fw-bold">🌐 Siber-Fiziksel Akustik Darbe Taraması</h6>
            <p class="mb-0 small text-white-50">Sistem mikrofon üzerinden sismik şok dalgalarını tarar. Masaya vurulduğunda otonom şebeke koruması, harita odağı ve sismik dalga efekti tetiklenir.</p>
        </div>
        <div class="d-flex gap-2">
            <button id="btnSensörAktif" class="btn btn-outline-success rounded-pill fw-bold px-4" onclick="sensoruBaslat()">
                🟢 Canlı Akustik Sensörü Başlat
            </button>
        </div>
    </div>
</div>

<div id="afetHaritasiKapsayici" class="row pt-2 mb-5">
    <div class="col-12">
        <div id="haritaKartKapsayici" class="card shadow-lg border-0 rounded-4 overflow-hidden">

            <div class="card-header bg-dark text-white d-flex flex-column flex-md-row justify-content-between align-items-center py-3 px-4 border-0">
                <h6 class="mb-0 fw-bold font-monospace text-white-50 m-0" style="letter-spacing: 1px;">
                    ORTAK OPERASYONEL KRİZ EKRANI
                </h6>

                <div class="d-flex flex-column flex-sm-row align-items-center gap-2 mt-3 mt-md-0 w-100 w-md-auto justify-content-end">

                    <button id="btnCanliGps" class="btn btn-matrix rounded-pill px-3 py-2 shadow-sm" onclick="canliGpsKonumunuBagla()">
                        Saha Konumu
                    </button>

                    <button id="btnKarargah" class="btn btn-matrix rounded-pill px-3 py-2 shadow-sm" onclick="karargahlariGoster()">
                        AFAD Merkezleri
                    </button>

                    <button id="btnTrafik" class="btn btn-matrix rounded-pill px-3 py-2 shadow-sm" onclick="trafikGoster()">
                        Canlı Trafik
                    </button>

                    <select id="sehirSecimi" class="form-select form-select-sm rounded-pill select-matrix px-3 font-monospace" style="width: 200px; cursor: pointer;" onchange="sehreOdaklanVeToplanmaAlanlariniGetir()">
                        <option value="">Bölge Seçiniz...</option>
                        <option value="adiyaman">Adıyaman</option>
                        <option value="hatay">Hatay</option>
                        <option value="kahramanmaras">Kahramanmaraş</option>
                        <option value="gaziantep">Gaziantep</option>
                        <option value="istanbul">İstanbul</option>
                        <option value="ankara">Ankara</option>
                        <option value="izmir">İzmir</option>
                    </select>

                    <button id="btnYenile" class="btn btn-matrix rounded-pill px-3 py-2 shadow-sm" onclick="afetVerileriniGetir()">
                        Verileri Yenile
                    </button>

                    <div id="sistemDurumRozeti" class="bg-danger text-white rounded-pill fw-bold px-3 py-2 d-flex align-items-center font-monospace text-uppercase shadow-sm" style="font-size: 0.75rem; height: 38px;">
                        <span class="spinner-grow spinner-grow-sm me-2" role="status" style="width: 8px; height: 8px;"></span>
                        Sistem Aktif
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div id="turkiyeHaritasi" style="height: 550px; width: 100%; display: block; min-height: 550px; z-index: 1;"></div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/komutaMerkezi.js" asp-append-version="true"></script>