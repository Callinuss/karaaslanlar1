@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center mt-5 mb-5">
    <h1 class="display-4 section-title text-danger">Kriz Anında Hızlı Çözüm</h1>
    <p class="lead text-muted max-w-2xl mx-auto mt-3">Afet durumlarında ihtiyaç sahipleri ile lojistik ekiplerini bir araya getiren canlı harita destekli açık kaynaklı karar sistemidir.</p>
</div>

<div class="card border-0 bg-dark text-white p-3 mb-4 rounded-4 shadow d-flex flex-row justify-content-between align-items-center border border-secondary">
    <div>
        <h6 id="sensorBaslik" class="mb-1 text-warning fw-bold">🌐 Akıllı Şehir Canlı Deprem Algılama Sistemi</h6>
        <p class="mb-0 small text-white-50">Sistem mikrofon üzerinden donanımsal sarsıntı ve şok dalgalarını canlı tarar. Masaya vurulduğunda otonom tetiklenir.</p>
    </div>
    <div class="d-flex gap-2">
        <button id="btnSensörAktif" class="btn btn-outline-success rounded-pill fw-bold px-4" onclick="sensoruBaslat()">
            🟢 Canlı Akustik Sensörü Başlat
        </button>
    </div>
</div>

<div class="row mt-4 justify-content-center">
    <div class="col-md-8 mb-4">
        <div class="card border-0 p-4 shadow-lg text-center bg-white rounded-4">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h2 class="fw-bold text-danger mb-3">🚨 Acil Yardım İste</h2>
                    <p class="text-muted fs-5">Bölgenizdeki acil lojistik ihtiyaçları (çadır, su, ilaç, tahliye) sisteme girerek saha ekiplerine ve yapay zeka triyaj merkezine anında ulaştırın.</p>
                </div>
                <div class="mt-3">
                    <a asp-controller="AfetTalepleri" asp-action="Create" class="btn btn-danger btn-lg rounded-pill px-5 py-3 fw-bold shadow">Yeni İhtiyaç Bildirimi Oluştur</a>
                </div>
            </div>
        </div>
    </div>
</div>

<hr class="my-5 opacity-25" />

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div id="afetHaritasiKapsayici" class="row mb-5 pt-2">
    <div class="col-12">
        <div id="haritaKartKapsayici" class="card shadow-lg border-0">
            <div class="card-header bg-dark text-white d-flex flex-column flex-md-row justify-content-between align-items-center py-3 px-4">
                <h5 class="mb-0 fw-bold d-flex align-items-center">📍 Canlı Çoklu Afet ve Kriz Haritası</h5>

                <div class="d-flex flex-column flex-sm-row align-items-center gap-3 mt-3 mt-md-0 w-100 w-md-auto justify-content-end">
                    <select id="sehirSecimi" class="form-select form-select-sm rounded-pill border-0 px-3 py-2 fw-bold bg-secondary text-white" style="width: 230px; font-size: 0.85rem; cursor: pointer;" onchange="sehreOdaklanVeToplanmaAlanlariniGetir()">
                        <option value="">🔍 Bölgesel Toplanma Alanı Seç...</option>
                        <option value="adiyaman">Adıyaman</option>
                        <option value="hatay">Hatay</option>
                        <option value="kahramanmaras">Kahramanmaraş</option>
                        <option value="gaziantep">Gaziantep</option>
                    </select>

                    <button id="btnYenile" class="btn btn-warning rounded-pill fw-bold px-4 py-2 d-flex align-items-center shadow-sm" onclick="afetVerileriniGetir()" style="font-size: 0.85rem;">
                        <span class="me-2">🔄</span> Verileri Yenile
                    </button>

                    <div id="sistemDurumRozeti" class="bg-danger text-white rounded-pill fw-bold px-4 py-2 d-flex align-items-center shadow-sm" style="font-size: 0.85rem;">
                        <span class="spinner-grow spinner-grow-sm me-2" role="status"></span>
                        Sistem Aktif
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div id="turkiyeHaritasi" style="height: 530px; width: 100%; display: block; min-height: 530px; transition: all 0.3s ease;"></div>
            </div>
        </div>
    </div>
</div>

<script>
    var map = L.map('turkiyeHaritasi').setView([39.0, 35.0], 6);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(map);

    // İKON TANIMLAMALARI
    var depremIcon = L.icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-orange.png',
        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
        iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34]
    });

    var yanginIcon = L.icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png',
        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
        iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34]
    });

    var selIcon = L.icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-blue.png',
        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
        iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34]
    });

    var toplanmaIcon = L.icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-green.png',
        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
        iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34]
    });

    var iotNormalIcon = L.icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-green.png',
        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
        iconSize: [20, 32], iconAnchor: [10, 32], popupAnchor: [1, -30]
    });

    var iotAlarmIcon = L.icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-violet.png',
        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
        iconSize: [28, 45], iconAnchor: [14, 45], popupAnchor: [1, -40]
    });

    var afetLayer = L.layerGroup().addTo(map);
    var toplanmaLayer = L.layerGroup().addTo(map);
    var iotLayer = L.layerGroup().addTo(map);

    var sensorBilgileri = [
        { id: 1, isim: "GAZİANTEP - BOTAS Ana Gaz Dağıtım IoT Vanası", enlem: 37.0662, boylam: 37.3833, tur: "Gaz" },
        { id: 2, isim: "GAZİANTEP - TEİAŞ Trafo Merkezi Akıllı Şebeke Sensörü", enlem: 37.0850, boylam: 37.4100, tur: "Elektrik" }
    ];

    var aktifIotMarkerlar = [];
    var alarmVerildiMi = false;
    var aktifSirenSesMotoru = null;

    var sesMikrofonAkisi = null;
    var javascriptIslemeNode = null;

    function iotSensorleriniYukle() {
        iotLayer.clearLayers();
        aktifIotMarkerlar = [];
        sensorBilgileri.forEach(function(sensor) {
            var marker = L.marker([sensor.enlem, sensor.boylam], {icon: iotNormalIcon})
                .bindPopup("<b>📡 IoT İstasyonu:</b> " + sensor.isim + "<br><span class='text-success fw-bold'>● Durum: Güvenli / Akış Aktif</span>");
            iotLayer.addLayer(marker);
            aktifIotMarkerlar.push({ id: sensor.id, marker: marker, data: sensor });
        });
    }

    // MİS GİBİ ÇALIŞAN O REAKSİYON MOTORU
    function sensoruBaslat() {
        var btn = document.getElementById("btnSensörAktif");

        if (alarmVerildiMi) {
            sistemiSifirla();
            return;
        }

        if (sesMikrofonAkisi) {
            sistemiSifirla();
            return;
        }

        navigator.mediaDevices.getUserMedia({ audio: true, video: false })
            .then(function(stream) {
                sesMikrofonAkisi = stream;
                btn.innerHTML = "🔍 Taramayı İptal Et / Durdur";
                btn.className = "btn btn-warning rounded-pill fw-bold px-4 animate-pulse";

                // SADECE BUTONA BASILIP AKTİF OLDUĞUNDA BU YAZI GELECEK
                document.getElementById("sensorBaslik").innerHTML = "🌐 Akıllı Şehir Canlı Deprem Algılama Sistemi (Akustik Şok Sensörü Aktif)";

                var audioContext = new (window.AudioContext || window.webkitAudioContext)();
                var duser = audioContext.createMediaStreamSource(stream);
                var analizor = audioContext.createAnalyser();
                javascriptIslemeNode = audioContext.createScriptProcessor(2048, 1, 1);

                analizor.smoothingTimeConstant = 0.3;
                analizor.fftSize = 1024;

                duser.connect(analizor);
                analizor.connect(javascriptIslemeNode);
                javascriptIslemeNode.connect(audioContext.destination);

                javascriptIslemeNode.onaudioprocess = function() {
                    if (alarmVerildiMi) return;

                    var dizi = new Uint8Array(analizor.frequencyBinCount);
                    analizor.getByteFrequencyData(dizi);
                    var degerler = 0;

                    for (var i = 0; i < dizi.length; i++) {
                        degerler += dizi[i];
                    }

                    var ortalamaSesGurlutusu = degerler / dizi.length;

                    // Masaya vurunca çalışan o desibel eşiği kanka
                    if (ortalamaSesGurlutusu > 65) {
                        alarmVerildiMi = true;
                        iotSarsintiTetikle("Donanımsal Sismik Darbe Sensörü");
                    }
                };
            })
            .catch(function(err) {
                alert("Mikrofon erişim izni gerekiyor kanka, tarayıcıdan onay ver.");
            });
    }

    function iotSarsintiTetikle(kaynak) {
        // DARBE ANINDA SAYFAYI HARİTAYA KAYDIRAN BOMBA SATIR
        var haritaKapsayici = document.getElementById("afetHaritasiKapsayici");
        if(haritaKapsayici) {
            haritaKapsayici.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        // Siren Sesi
        try {
            var audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            aktifSirenSesMotoru = audioCtx.createOscillator();
            var gainNode = audioCtx.createGain();
            aktifSirenSesMotoru.connect(gainNode);
            gainNode.connect(audioCtx.destination);
            aktifSirenSesMotoru.type = 'sawtooth';
            aktifSirenSesMotoru.frequency.setValueAtTime(440, audioCtx.currentTime);
            gainNode.gain.setValueAtTime(0.3, audioCtx.currentTime);
            aktifSirenSesMotoru.start();
        } catch(e) {}

        var haritaDiv = document.getElementById("turkiyeHaritasi");
        var rozet = document.getElementById("sistemDurumRozeti");
        var btn = document.getElementById("btnSensörAktif");

        btn.innerHTML = "🔄 Alarmı Sustur ve Sistemi Sıfırla";
        btn.className = "btn btn-light text-danger border border-danger rounded-pill fw-bold px-4";

        haritaDiv.style.border = "6px solid #dc3545";
        haritaDiv.style.boxShadow = "0 0 35px rgba(220, 53, 69, 0.8)";

        rozet.innerHTML = "🚨 SENSÖR TETİKLENDİ: OTONOM KORUMA AKTİF!";
        rozet.className = "bg-dark text-danger rounded-pill fw-bold px-4 py-2 d-flex align-items-center shadow-sm border border-danger";

        map.flyTo([37.0662, 37.3833], 12, { animate: true, duration: 1.2 });

        setTimeout(() => {
            if (!alarmVerildiMi) return;
            iotLayer.clearLayers();
            aktifIotMarkerlar.forEach(function(item) {
                var krizMarker = L.marker([item.data.enlem, item.data.boylam], {icon: iotAlarmIcon})
                    .addTo(iotLayer)
                    .bindPopup(
                        "<div class='p-1'><h6 class='text-danger fw-bold mb-1'>🚨 " + kaynak + "</h6>" +
                        "<p class='small mb-2'><b>İstasyon:</b> " + item.data.isim + "</p>" +
                        "<div class='alert alert-danger py-1 px-2 small mb-0 fw-bold'>⚠️ Şok Dalga Algılandı! Şebeke Güvenliği İçin Hat Kapatıldı.</div></div>"
                    );
                if(item.data.id === 1) {
                    setTimeout(() => { krizMarker.openPopup(); }, 500);
                }
            });
        }, 1300);
    }

    function sistemiSifirla() {
        alarmVerildiMi = false;

        // SİSTEM DURDURULDUĞUNDA VEYA SIFIRLANDIĞINDA PARANTEZ İÇİ YAZI TAMAMEN SİLİNİR
        document.getElementById("sensorBaslik").innerHTML = "🌐 Akıllı Şehir Canlı Deprem Algılama Sistemi";

        if (aktifSirenSesMotoru) {
            try { aktifSirenSesMotoru.stop(); } catch(e){}
            aktifSirenSesMotoru = null;
        }

        if (sesMikrofonAkisi) {
            sesMikrofonAkisi.getTracks().forEach(track => track.stop());
            sesMikrofonAkisi = null;
        }
        if (javascriptIslemeNode) {
            javascriptIslemeNode.onaudioprocess = null;
            javascriptIslemeNode = null;
        }

        var haritaDiv = document.getElementById("turkiyeHaritasi");
        var rozet = document.getElementById("sistemDurumRozeti");
        var btn = document.getElementById("btnSensörAktif");

        btn.innerHTML = "🟢 Canlı Akustik Sensörü Başlat";
        btn.className = "btn btn-outline-success rounded-pill fw-bold px-4";

        haritaDiv.style.border = "none";
        haritaDiv.style.boxShadow = "none";

        rozet.innerHTML = "<span class='spinner-grow spinner-grow-sm me-2' role='status'></span> Sistem Aktif";
        rozet.className = "bg-danger text-white rounded-pill fw-bold px-4 py-2 d-flex align-items-center shadow-sm";

        map.flyTo([39.0, 35.0], 6, { animate: true, duration: 1.2 });
        iotSensorleriniYukle();
    }

    var sehirVerileri = {
        adiyaman: {
            merkez: [37.7648, 38.2786], zoom: 13,
            alanlar: [
                { isim: "Adıyaman Fuar Alanı Güvenli Toplanma Bölgesi", enlem: 37.7550, boylam: 38.2680, kapasite: "2500 Kişi", imkanlar: "Çadır Alanı, Sahra Hastanesi, Sıcak Yemek" },
                { isim: "Eğriçay Parkı Çadır ve Lojistik Alanı", enlem: 37.7720, boylam: 38.2920, kapasite: "4000 Kişi", imkanlar: "Temiz Su, Elektrik Altyapısı, Çocuk Alanı" }
            ]
        },
        hatay: {
            merkez: [36.2023, 36.1613], zoom: 12,
            alanlar: [
                { isim: "Hatay Stadyumu Geçici Barınma Merkezi", enlem: 36.2510, boylam: 36.1850, kapasite: "5000 Kişi", imkanlar: "Konteyner Kent Altyapısı, Koordinasyon Merkezi" }
            ]
        },
        kahramanmaras: {
            merkez: [37.5746, 36.9371], zoom: 12,
            alanlar: [
                { isim: "Kafum Fuar Alanı Güvenli Bölge", enlem: 37.5580, boylam: 36.9520, kapasite: "3000 Kişi", imkanlar: "Mobil Mutfak, Güvenlik, WC/Duş" }
            ]
        },
        gaziantep: {
            merkez: [37.0662, 37.3833], zoom: 12,
            alanlar: [
                { isim: "Gaziantep Festival Parkı Toplanma Alanı", enlem: 37.0780, bodylam: 37.3620, kapasite: "6000 Kişi", imkanlar: "Geniş Tahliye Alanı, Wi-Fi İstasyonu, İlk Yardım" }
            ]
        }
    };

    function afetVerileriniGetir() {
        var btn = document.getElementById("btnYenile");
        if(btn) {
            btn.innerHTML = "<span class='spinner-border spinner-border-sm me-2'></span> Yükleniyor...";
            btn.disabled = true;
        }
        afetLayer.clearLayers();

        fetch('https://api.orhanaydogdu.com.tr/deprem/kandilli/live')
            .then(response => response.json())
            .then(data => {
                var listelenenCount = 0;
                for (var i = 0; i < data.result.length; i++) {
                    if (listelenenCount >= 15) break;
                    var deprem = data.result[i];
                    if (deprem.mag > 2.5) {
                        var enlem = deprem.geojson.coordinates[1];
                        var boylam = deprem.geojson.coordinates[0];
                        var buyukluk = deprem.mag;
                        var yer = deprem.title;
                        var tarih = deprem.date || "Güncel";

                        var marker = L.marker([enlem, boylam], {icon: depremIcon})
                            .bindPopup(
                                "<div class='p-1'><h6 class='text-warning fw-bold mb-1'>💥 Deprem (M " + buyukluk + ")</h6>" +
                                "<p class='text-muted small mb-2'><strong>Konum:</strong> " + yer + "<br><strong>Tarih:</strong> " + tarih + "</p>" +
                                "<button onclick=\"acilEkipIste('" + yer + "', 'Deprem')\" class='btn btn-sm btn-danger w-100 rounded-pill shadow-sm'>Bölgeye Ekip İste</button></div>"
                            );
                        afetLayer.addLayer(marker);
                        listelenenCount++;
                    }
                }
                if(btn) { btn.innerHTML = "🔄 Verileri Yenile"; btn.disabled = false; }
            }).catch(err => {
                console.error("API hatası:", err);
                if(btn) { btn.innerHTML = "🔄 Verileri Yenile"; btn.disabled = false; }
            });

        var aktifYanginlar = [
            { konum: "Antalya / Manavgat Ormanlık Alanı", enlem: 36.78, boylam: 31.44, detay: "Tepe yangını, kuvvetli rüzgar etkisi" },
            { konum: "Muğla / Marmaris İçmeler Mevkii", enlem: 36.85, boylam: 28.27, detay: "Örtü yangını, havadan müdahale sürüyor" }
        ];

        aktifYanginlar.forEach(function(yangin) {
            var marker = L.marker([yangin.enlem, yangin.boylam], {icon: yanginIcon})
                .bindPopup(
                    "<div class='p-1'><h6 class='text-danger fw-bold mb-1'>🔥 Aktif Orman Yangını</h6>" +
                    "<p class='text-muted small mb-2'><strong>Konum:</strong> " + yangin.konum + "<br><strong>Durum:</strong> " + yangin.detay + "</p>" +
                    "<button onclick=\"acilEkipIste('" + yangin.konum + "', 'Yangin')\" class='btn btn-sm btn-danger w-100 rounded-pill shadow-sm'>İtfaiye Yönlendir</button></div>"
                );
            afetLayer.addLayer(marker);
        });

        var aktifSeller = [
            { konum: "Rize / Çayeli Merkez", enlem: 41.01, boylam: 40.72, detay: "Dere taşkını riski, metrekareye yoğun yağış" },
            { konum: "Giresun / Dereli İlçesi", enlem: 40.74, boylam: 38.45, detay: "Anlık su baskını, tahliye ekipleri sahada" }
        ];

        aktifSeller.forEach(function(sel) {
            var marker = L.marker([sel.enlem, sel.boylam], {icon: selIcon})
                .bindPopup(
                    "<div class='p-1'><h6 class='text-primary fw-bold mb-1'>🌊 Sel / Su Baskını Riski</h6>" +
                    "<p class='text-muted small mb-2'><strong>Konum:</strong> " + sel.konum + "<br><strong>Durum:</strong> " + sel.detay + "</p>" +
                    "<button onclick=\"acilEkipIste('" + sel.konum + "', 'Sel')\" class='btn btn-sm btn-danger w-100 rounded-pill shadow-sm'>Tahliye Ekibi İste</button></div>"
                );
            afetLayer.addLayer(marker);
        });
    }

    function sehreOdaklanVeToplanmaAlanlariniGetir() {
        var secilenSehir = document.getElementById("sehirSecimi").value;
        toplanmaLayer.clearLayers();
        if (secilenSehir && sehirVerileri[secilenSehir]) {
            var sehir = sehirVerileri[secilenSehir];
            map.flyTo(sehir.merkez, sehir.zoom, { animate: true, duration: 1.5 });
            sehir.alanlar.forEach(function (alan) {
                var marker = L.marker([alan.enlem, alan.boylam], { icon: toplanmaIcon })
                    .bindPopup("<div class='p-1'><h6 class='text-success fw-bold mb-1'>🌳 " + alan.isim + "</h6><p class='text-muted small mb-0'><strong>Kapasite:</strong> " + alan.kapasite + "</p><p class='text-muted small mb-0'><strong>Altyapı:</strong> " + alan.imkanlar + "</p></div>");
                toplanmaLayer.addLayer(marker);
            });
        } else { map.flyTo([39.0, 35.0], 6, { animate: true, duration: 1.2 }); }
    }

    function acilEkipIste(lokasyon, afetTuru) {
        window.location.href = '/AfetTalepleri/Create?gelenKonum=' + encodeURIComponent(lokasyon) + '&afetTuru=' + afetTuru;
    }

    afetVerileriniGetir();
    iotSensorleriniYukle();
</script>